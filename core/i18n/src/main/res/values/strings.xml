<?xml version="1.0" encoding="utf-8"?>
<!--
  Every user-facing string in the app lives here.

  Features own their code but not their copy: with ten locales, translators
  need one file to work on, not one per module. Source language is English,
  not Russian, because that is what translation vendors and every TMS expect.

  Rules: no string concatenation with numbers (use plurals), a comment on any
  string whose meaning is not obvious out of context, and no reuse of one
  string in two places that could diverge in another language.
-->
<resources>

    <!-- Noise types. Keep the recognisable colour word; the hint carries the meaning. -->
    <string name="noise_brown">Brown</string>
    <string name="noise_brown_hint">deep rumble</string>
    <string name="noise_pink">Pink</string>
    <string name="noise_pink_hint">soft and even</string>
    <string name="noise_white">White</string>
    <string name="noise_white_hint">full and bright</string>
    <string name="noise_blue">Blue</string>
    <string name="noise_blue_hint">airy</string>
    <string name="noise_violet">Violet</string>
    <string name="noise_violet_hint">sharp hiss</string>
    <string name="noise_grey">Grey</string>
    <string name="noise_grey_hint">evenly loud to the ear</string>
    <string name="noise_green">Green</string>
    <string name="noise_green_hint">mid-range, natural</string>

    <!-- Tone control. %1$s is a noise colour name such as "Pink". -->
    <string name="tone_label">Tone</string>
    <string name="tone_deeper_than">%1$s, deeper</string>
    <string name="tone_brighter_than">%1$s, brighter</string>
    <!-- Screen reader value: %1$s is the worded description, %2$s the slope number. -->
    <string name="tone_accessibility">%1$s, %2$s decibels per octave</string>

    <!-- Durations. %1$s is hours, %2$s is minutes, both already pluralised. -->
    <string name="duration_hours_minutes">%1$s %2$s</string>
    <plurals name="duration_minutes">
        <item quantity="one">%d minute</item>
        <item quantity="other">%d minutes</item>
    </plurals>
    <plurals name="duration_hours">
